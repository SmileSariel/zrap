managed implementation in class ZBP_RAP_I_EXCEL unique;
strict ( 2 );
with draft;
extensible;

define behavior for ZRAP_I_EXCEL alias EXCEL
with additional save
persistent table zrap_excel
extensible
draft table zrap_excel_d
etag master Locallastchangedat
lock master total etag Locallastchangedat
authorization master ( global )
{
  field ( readonly )
  WhoUUID,
  MessageType,
  MessageText,
  Processed,
  Createdby,
  Createdat,
  Lastchangedby,
  Lastchangedat,
  Locallastchangedat;

  field ( numbering : managed )
  WhoUUID;

  static action ( features : global ) fileUpload deep parameter zrap_a_file_parameter;
  static action fileDownload result [1] zrap_a_template;

  action ( features : instance ) call_bapi result [1..*] $self;

  determine action validatecustomer { validation validatedata; }
  determine action validatearticle  { validation validatedata; }

  determination checkmessage on modify { field Customer, Article; }

  side effects { field Customer affects field MessageType, field MessageCode, field MessageText;
                 field Article  affects field MessageType, field MessageCode, field MessageText;
                 //event refreshdata affects $self, messages;
                 determine action validatecustomer executed on field Customer affects messages;
                 determine action validatearticle  executed on field Article  affects messages;
                 action call_bapi affects field processed, $self; }

  event refreshdata for side effects;

  validation validatedata on save { create; update; field Customer, Article; }

  create ( precheck );
  update ( features : instance );
  delete ( features : instance );

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for zrap_excel corresponding extensible
    {
      WhoUUID            = who_uuid;
      Customer           = customer;
      Article            = article;
      MessageType        = messagetype;
      MessageText        = messagetext;
      Processed          = processed;
      Createdby          = createdby;
      Createdat          = createdat;
      Lastchangedby      = lastchangedby;
      Lastchangedat      = lastchangedat;
      Locallastchangedat = locallastchangedat;
    }

}