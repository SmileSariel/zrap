@Metadata.layer: #CORE  
@UI.headerInfo: {
  typeName: 'Develop Management',
  typeNamePlural: 'Customer Article Uploading', 
  typeImageUrl: 'sap-icon://syntax', 
  title: { 
    type: #STANDARD,
    value: 'Customer'
  },
  description: {
    type: #STANDARD,
    value: 'Article'
  }
}
annotate view ZRAP_C_EXCEL with
{
  @EndUserText.label: 'WhoUUID'
  @UI.facet: [ {
    label: 'General Information', 
    id: 'GeneralInfo', 
    purpose: #STANDARD, 
    position: 10 , 
    type: #IDENTIFICATION_REFERENCE
  } ]
  
  @UI.lineItem: [ {  
    type: #FOR_ACTION, 
    dataAction: 'FILEUPLOAD', 
    label: 'Upload File', 
    position: 10 
  }, {  
    type: #FOR_ACTION, 
    dataAction: 'FILEDOWNLOAD', 
    label: 'Download Template', 
    position: 20 
  } ]
  
  @UI.hidden: true
  WhoUUID;
  
  @UI.identification: [ {
    position: 20 
  } ]
  @UI.lineItem: [ {
    position: 20 
  } ]
  @UI.selectionField: [ {
    position: 20 
  } ]
  Customer;
  
  @EndUserText.label: 'Article'
  @UI.identification: [ {
    position: 30 , 
    label: 'Article'
  } ]
  @UI.lineItem: [ {
    position: 30 , 
    label: 'Article'
  } ]
  @UI.selectionField: [ {
    position: 30 
  } ]
  Article;
  
  @EndUserText.label: 'Message Type'
  @UI.identification: [ {
    position: 40,
    criticality: 'MessageCode'
  } ]
  @UI.lineItem: [ {
    position: 40,
    criticality: 'MessageCode'
  } ]
  MessageType;
  
  @EndUserText.label: 'Message'
  MessageCode;
  
  @EndUserText.label: 'Message Text'
  @UI.identification: [ {
    position: 50 
  } ]
  @UI.lineItem: [ {
    position: 50 
  } ]
  MessageText;
  
  @UI.identification: [ {
    position: 60 
  } ]
  @UI.lineItem: [ {
    position: 60 
  } ]
  @UI.selectionField: [ {
    position: 60 
  } ]
  Createdby;
  
  @UI.hidden: true
  Createdat;
  
  @UI.hidden: true
  Lastchangedby;
  
  @UI.hidden: true
  Lastchangedat;
  
  @UI.hidden: true
  Locallastchangedat;
   
  @UI.hidden: true
  _BaseEntity;
}