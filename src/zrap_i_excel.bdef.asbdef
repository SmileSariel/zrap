managed implementation in class ZBP_RAP_I_EXCEL unique;
strict ( 2 );
with draft;
extensible;

define behavior for ZRAP_I_EXCEL alias EXCEL
with additional save
persistent table zrap_excel
extensible
draft table zrap_excel_d
etag master Locallastchangedat
lock master total etag Locallastchangedat
authorization master ( global )
{
  field ( readonly )
  WhoUUID,
  MessageType,
  MessageText,
  Createdby,
  Createdat,
  Lastchangedby,
  Lastchangedat,
  Locallastchangedat;

  field ( numbering : managed )
  WhoUUID;

  static factory action ( features : global ) fileUpload deep parameter zrap_a_file_parameter [0..*];
  static action fileDownload result [1] zrap_a_template;

  //event refreshdata for side effects;

  //side effects { event refreshdata affects $self, messages; }

  validation validatedata on save { create; field Customer, Article; }

  create ( precheck );
  update;
  delete ( features : global );

  draft action Activate optimized;
  draft action Discard;
  draft action Edit;
  draft action Resume;
  draft determine action Prepare;

  mapping for zrap_excel corresponding extensible
    {
      WhoUUID            = who_uuid;
      Customer           = customer;
      Article            = article;
      MessageType        = messagetype;
      MessageText        = messagetext;
      Createdby          = createdby;
      Createdat          = createdat;
      Lastchangedby      = lastchangedby;
      Lastchangedat      = lastchangedat;
      Locallastchangedat = locallastchangedat;
    }

}