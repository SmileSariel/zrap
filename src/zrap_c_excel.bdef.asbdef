projection implementation in class ZBP_RAP_C_EXCEL unique;
strict ( 2 );
extensible;
use draft;
use side effects;

define behavior for ZRAP_C_EXCEL alias EXCEL
extensible
use etag
{
  use create;
  use update;
  use delete;

  use action fileUpload;
  use action fileDownload;
  use action call_bapi;

  use action validatecustomer;
  use action validatearticle;

  side effects { field Customer affects field MessageType, field MessageCode, field MessageText;
                  field Article  affects field MessageType, field MessageCode, field MessageText;
                  //event refreshdata affects $self, messages;
                  determine action validatecustomer executed on field Customer affects messages;
                  determine action validatearticle  executed on field Article  affects messages;
                  action call_bapi affects field processed, $self; }

  use event refreshdata;

  use action Edit;
  use action Activate;
  use action Discard;
  use action Resume;
  use action Prepare;

}